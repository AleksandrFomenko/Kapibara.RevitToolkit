<Page x:Class="SheetManager.Views.PrintSheetsView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://Kapibara/xaml"
      xmlns:model="clr-namespace:SheetManager.Models">
    <Page.Resources>
        <HierarchicalDataTemplate DataType="{x:Type model:FolderItem}" ItemsSource="{Binding AllChildren}">
            <CheckBox Content="{Binding Name}" IsChecked="{Binding IsChecked, Mode=TwoWay}"/>
        </HierarchicalDataTemplate>
        <DataTemplate DataType="{x:Type model:SheetItem}">
            <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}">
                <TextBlock><Run Text="{Binding Number}"/><Run Text=" — "/><Run Text="{Binding Name}"/></TextBlock>
            </CheckBox>
        </DataTemplate>
    </Page.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="Печать листов в PDF" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,20"/>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="340"/></Grid.ColumnDefinitions>
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <WrapPanel Margin="0,0,0,12">
                    <Button Content="Выбрать все" Command="{Binding SelectAllCommand}" Margin="0,0,8,4"/>
                    <Button Content="Снять выбор" Command="{Binding ClearSelectionCommand}" Margin="0,0,8,4"/>
                    <Button Content="Обновить" Command="{Binding RefreshCommand}" Margin="0,0,0,4"/>
                </WrapPanel>
                <TreeView Grid.Row="1" ItemsSource="{Binding TreeItems}" HorizontalContentAlignment="Stretch">
                    <TreeView.ItemContainerStyle>
                        <Style TargetType="TreeViewItem"><Setter Property="IsExpanded" Value="True"/></Style>
                    </TreeView.ItemContainerStyle>
                </TreeView>
                <TextBlock Grid.Row="2" Text="{Binding SelectedCount, StringFormat=Выбрано листов: {0}}" Margin="0,12,0,0"/>
            </Grid>
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Сохранение PDF" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,16"/>
                    <Button Content="Выбрать папку" Command="{Binding SelectPathCommand}" HorizontalAlignment="Left"/>
                    <TextBox Text="{Binding PathFolder, UpdateSourceTrigger=PropertyChanged}" Margin="0,12,0,20"
                             ToolTip="Папка для сохранения PDF"/>
                    <CheckBox Content="Объединить в один PDF" IsChecked="{Binding Combine}" Margin="0,0,0,16"/>
                    <TextBlock Text="Имя общего файла" Margin="0,0,0,8"/>
                    <TextBox Text="{Binding FileName, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Combine}" Margin="0,0,0,16"/>
                    <TextBlock Text="Для отдельных PDF имена файлов формируются по правилам Revit." TextWrapping="Wrap" Margin="0,0,0,24"/>
                    <ui:Button Content="Сохранить PDF" Appearance="Primary" Command="{Binding PrintCommand}" HorizontalAlignment="Right"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
        <TextBlock Grid.Row="2" Text="{Binding Message}" TextWrapping="Wrap" Margin="0,16,0,0"/>
    </Grid>
</Page>
