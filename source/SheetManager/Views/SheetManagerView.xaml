<ui:FluentWindow
    x:Class="SheetManager.Views.SheetManagerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ui="http://Kapibara/xaml"
    xmlns:views="clr-namespace:SheetManager.Views"
    mc:Ignorable="d"
    Title="{Binding Title}"
    MinHeight="650"
    MinWidth="1050"
    ResizeMode="CanResize"
    WindowStartupLocation="CenterScreen"
    Height="800"
    Width="1200"
    ScrollViewer.CanContentScroll="False"
    ExtendsContentIntoTitleBar="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ui:TitleBar Grid.Row="0" Title="{Binding Title}"/>
        <ui:NavigationView Grid.Row="1"
                           x:Name="RootNavigationView"
                           FontSize="10"
                           PaneDisplayMode="LeftFluent">
            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem
                    Content="Создание листов"
                    FontSize="14"
                    Icon="{ui:SymbolIcon DocumentQueueAdd24}"
                    TargetPageType="{x:Type views:CreateSheetsView}" />
                
                <ui:NavigationViewItem
                    Content="Печать листов"
                    FontSize="14"
                    Icon="{ui:SymbolIcon Print24}"
                    TargetPageType="{x:Type views:PrintSheetsView}" />

                <ui:NavigationViewItem
                    Content="Нумерация"
                    FontSize="14"
                    Icon="{ui:SymbolIcon TextNumberListLtr24}"
                    IsEnabled="False" />
            </ui:NavigationView.MenuItems>
        </ui:NavigationView>
        <StackPanel Grid.Row="2" Margin="24,8,24,12">
            <TextBlock Text="{Binding DocumentName}" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Margin="0,4,0,0"/>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
