<ui:FluentWindow
    x:Class="SheetManager.Views.SheetManagerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ui="http://Kapibara/xaml"
    xmlns:views="clr-namespace:SheetManager.Views"
    mc:Ignorable="d"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterScreen"
    Height="800"
    Width="1200"
    ScrollViewer.CanContentScroll="False"
    ExtendsContentIntoTitleBar="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <ui:TitleBar Grid.Row="0" Title="Sheet Manager"/>
        <ui:NavigationView Grid.Row="1"
                           x:Name="RootNavigationView"
                           FontSize="10"
                           PaneDisplayMode="LeftFluent">
            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem
                    Content="Создать"
                    FontSize="14"
                    Icon="{ui:SymbolIcon DocumentQueueAdd24}"
                    TargetPageType="{x:Type views:CreateSheetsView}" />
                
                <ui:NavigationViewItem
                    Content="Номер"
                    FontSize="14"
                    Icon="{ui:SymbolIcon TextNumberListLtr24}"
                    TargetPageType="{x:Type views:PrintSheetsView}" />
                
                <ui:NavigationViewItem
                    Content="Печать"
                    FontSize="14"
                    Icon="{ui:SymbolIcon Print24}"
                    TargetPageType="{x:Type views:PrintSheetsView}" />
            </ui:NavigationView.MenuItems>
        </ui:NavigationView>
    </Grid>
</ui:FluentWindow>