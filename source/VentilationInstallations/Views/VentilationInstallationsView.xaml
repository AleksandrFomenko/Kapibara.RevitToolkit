<ui:FluentWindow
    x:Class="VentilationInstallations.Views.VentilationInstallationsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:viewModel="clr-namespace:VentilationInstallations.ViewModels"
    xmlns:ui="http://Kapibara/xaml"
    xmlns:converters="clr-namespace:VentilationInstallations.Converters"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance viewModel:VentilationInstallationsViewModel}"
    WindowStartupLocation="CenterScreen"
    Title="VentilationInstallations"
    Height="800"
    Width="1300">

    <ui:FluentWindow.Resources>
        <converters:EnumDescriptionConverter x:Key="EnumDescriptionConverter" />
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="170" />
            <RowDefinition Height="*" />
            <RowDefinition Height="60" />
        </Grid.RowDefinitions>
        <ui:TitleBar Grid.Row="0" Title="Вентиляционные установки" />

        <ui:Card Grid.Row="1" Margin="10,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition Height="10"/>
                    <RowDefinition />
                    <RowDefinition Height="10"/>
                    <RowDefinition />
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Orientation="Horizontal">
                    <ui:TextBlock Text="Выбор элементов" VerticalAlignment="Center" />
                    <Separator Width="10" Visibility="Hidden" />
                    <ComboBox
                        ItemsSource="{Binding SelectionOptions}"
                        SelectedItem="{Binding SelectionOption}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock
                                    Text="{Binding 
                            Converter={StaticResource EnumDescriptionConverter}}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Separator Width="10" Visibility="Hidden" />
                    <ui:Button Content="Выделить отмеченные"
                               Appearance="Primary"
                               Command="{Binding SelectCheckedCommand}" />
                </StackPanel>
                <Grid Grid.Row="2">
                    <StackPanel Orientation="Horizontal">
                        <ui:TextBlock Text="Наименование" VerticalAlignment="Center"/>
                        <Separator Width="10" Visibility="Hidden" />
                        <ui:SymbolIcon Symbol="ArrowForward24"/>
                        <Separator Width="10" Visibility="Hidden" />
                        <ComboBox 
                            ItemsSource="{Binding StringParameters}"
                            SelectedItem="{Binding SelectedParameterName}"/>
                        <Separator Width="15" Visibility="Hidden" />
                        
                        <ui:TextBlock Text="Наименование краткое" VerticalAlignment="Center"/>
                        <Separator Width="10" Visibility="Hidden" />
                        <ui:SymbolIcon Symbol="ArrowForward24"/>
                        <Separator Width="10" Visibility="Hidden" />
                        <ComboBox ItemsSource="{Binding StringParameters}"
                                  SelectedItem="{Binding SelectedParameterNameBrief}"/>
                    </StackPanel>
                </Grid>
                
                <Grid Grid.Row="4">
                    <StackPanel Orientation="Horizontal">
                    <ui:TextBlock Text="Марка" VerticalAlignment="Center"/>
                    <Separator Width="10" Visibility="Hidden" />
                    <ui:SymbolIcon Symbol="ArrowForward24"/>
                    <Separator Width="10" Visibility="Hidden" />
                    <ComboBox ItemsSource="{Binding StringParameters}"
                              SelectedItem="{Binding SelectedParameterMark}"/>
                    <Separator Width="15" Visibility="Hidden" />
                    
                    <ui:TextBlock Text="Завод" VerticalAlignment="Center"/>
                    <Separator Width="10" Visibility="Hidden" />
                    <ui:SymbolIcon Symbol="ArrowForward24"/>
                    <Separator Width="10" Visibility="Hidden" />
                    <ComboBox ItemsSource="{Binding StringParameters}"
                              SelectedItem="{Binding SelectedParameterFactory}"/>
                    <Separator Width="10" Visibility="Hidden" />
                    <TextBox Text="{Binding Factory}"/>
                    
                    </StackPanel>
                </Grid>
            </Grid>
            
        </ui:Card>
        <ui:Card Grid.Row="2" Margin="10,5" VerticalAlignment="Top">
            <ui:DataGrid ItemsSource="{Binding Units}"
                         AutoGenerateColumns="False"
                         CanUserAddRows="False"
                         CanUserDeleteRows="False"
                         IsReadOnly="True"
                         HeadersVisibility="Column"
                         GridLinesVisibility="Horizontal"
                         SelectionUnit="FullRow"
                         EnableRowVirtualization="True">
                <DataGrid.Columns>

                    <DataGridTemplateColumn Width="44" SortMemberPath="IsChecked">
                        <DataGridTemplateColumn.HeaderTemplate>
                            <DataTemplate>
                                <CheckBox IsThreeState="False"
                                          HorizontalAlignment="Center"
                                          IsChecked="{Binding DataContext.IsAllChecked,
                      RelativeSource={RelativeSource AncestorType={x:Type DataGrid}},
                      Mode=TwoWay}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.HeaderTemplate>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          IsChecked="{Binding IsChecked, UpdateSourceTrigger=PropertyChanged}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="Наименование семейства"
                                        Binding="{Binding FamilyName}"
                                        Width="*" MinWidth="200" />

                    <DataGridTextColumn Header="Уровень"
                                        Binding="{Binding LevelName}"
                                        Width="Auto" MinWidth="80" />

                    <DataGridTextColumn Header="Рабочий набор"
                                        Binding="{Binding Workset}"
                                        Width="Auto" MinWidth="100" />

                    <DataGridTextColumn Header="Система"
                                        Binding="{Binding SystemName}"
                                        Width="Auto" MinWidth="70">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center" />
                                <Setter Property="VerticalAlignment" Value="Center" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTemplateColumn Width="Auto">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ui:Button Content="Выбрать"
                                           Padding="8,2"
                                           Margin="4,2"
                                           Appearance="Secondary"
                                           Command="{Binding DataContext.SelectCommand,
                                           RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"
                                           CommandParameter="{Binding}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                </DataGrid.Columns>
            </ui:DataGrid>
        </ui:Card>

        <ui:Button Grid.Row="3" 
                   Appearance="Primary" 
                   Content="Выполнить" 
                   HorizontalAlignment="Center" 
                   Command="{Binding ExecuteCommand}"/>
    </Grid>
</ui:FluentWindow>