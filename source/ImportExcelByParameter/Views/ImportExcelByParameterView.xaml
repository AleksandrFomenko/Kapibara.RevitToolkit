<ui:FluentWindow
     x:Class="ImportExcelByParameter.Views.ImportExcelByParameterView"
     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
     xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
     xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
     xmlns:ui="http://Kapibara/xaml"
     xmlns:wpf="clr-namespace:FluentIcons.Wpf;assembly=FluentIcons.Wpf"
     xmlns:converters="clr-namespace:ImportExcelByParameter.Converters"
     mc:Ignorable="d"
     ResizeMode="CanMinimize"
     SizeToContent="Height"
     WindowStartupLocation="CenterScreen"
     Width="500">
    <ui:FluentWindow.Resources>
        <converters:EnumDescriptionConverter x:Key="EnumDescriptionConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </ui:FluentWindow.Resources>

    <DockPanel>
        <ui:TitleBar DockPanel.Dock="Top" Title="Import excel"/>

        <ui:Button
            DockPanel.Dock="Bottom"
            Appearance="Primary"
            Content="Execute"
            HorizontalAlignment="Center"
            Margin="0,10"
            Command="{Binding StartCommand}"
            Icon="{ui:SymbolIcon DocumentTableTruck24}"/>
        
        <ProgressBar
            DockPanel.Dock="Bottom"
            Height="4"
            Margin="10,0,10,4"
            Value="{Binding CurrentProgress}"
            Maximum="{Binding MaxProgress}"
            IsIndeterminate="{Binding IsIndeterminate}"/>

        <StackPanel Margin="10,8" VerticalAlignment="Top">
            
            <ui:Card Margin="0,0,0,8">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="150"/>
                        </Grid.ColumnDefinitions>
                        <wpf:FluentIcon Grid.Column="0"
                                        Icon="DocumentTable"
                                        IconVariant="Regular"
                                        FontSize="24"
                                        Width="32"
                                        Height="32"/>
                        <ui:Button Grid.Column="1"
                                   Appearance="Caution"
                                   Content="Выбрать путь"
                                   HorizontalAlignment="Left"
                                   Command="{Binding SelectPathCommand}"/>
                    </Grid>
                    <TextBlock Margin="0,6,0,0" Text="{Binding PathExcel}"/>
                </StackPanel>
            </ui:Card>
            
            <ui:Card Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock Text="Выбор листа и номера строки"/>
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="125"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox Grid.Column="0"
                                  Margin="0,0,10,0"
                                  ItemsSource="{Binding Sheets}"
                                  SelectedItem="{Binding Sheet, Mode=TwoWay}"/>
                        <ui:NumberBox Grid.Column="1"
                                      PlaceholderText="Номер"
                                      MaxDecimalPlaces="0"
                                      Value="{Binding RowNumber}"/>
                    </Grid>
                </StackPanel>
            </ui:Card>
            
            <ui:Card Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock Text="Режим выборки элементов"/>
                    <ComboBox
                        Margin="0,6,0,0"
                        ItemsSource="{Binding SelectionModes}"
                        SelectedItem="{Binding SelectionMode, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource EnumDescriptionConverter}}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
            </ui:Card>
            
            <ui:Card Margin="0,0,0,8"
                     Visibility="{Binding IsCategoryVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel>
                    <TextBlock Text="Выбор категории"/>
                    <ComboBox
                        Margin="0,6,0,0"
                        ItemsSource="{Binding Categories}"
                        SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"/>
                </StackPanel>
            </ui:Card>
            
            <ui:Card>
                <StackPanel>
                    <TextBlock Text="Выбор параметра"/>
                    <ui:TextBox
                        Margin="0,6,0,6"
                        Text="{Binding ParameterFilter, UpdateSourceTrigger=PropertyChanged}"
                        PlaceholderText="Поиск..."/>
                    <ComboBox
                        ItemsSource="{Binding Parameters}"
                        SelectedItem="{Binding Parameter}"/>
                </StackPanel>
            </ui:Card>

        </StackPanel>
    </DockPanel>
</ui:FluentWindow>