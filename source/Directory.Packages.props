<Project>
    <PropertyGroup>
        <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
        <CentralPackageFloatingVersionsEnabled>true</CentralPackageFloatingVersionsEnabled>
    </PropertyGroup>

    <ItemGroup>
        <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2"/>
        <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.7"/>
        <PackageVersion Include="System.Text.Json" Version="9.*"/>
        <PackageVersion Include="Nice3point.Revit.Toolkit" Version="$(RevitVersion).*"/>
        <PackageVersion Include="Nice3point.Revit.Extensions" Version="$(RevitVersion).*"/>
        <PackageVersion Include="Nice3point.Revit.Api.RevitAPI" Version="$(RevitVersion).*"/>
        <PackageVersion Include="Nice3point.Revit.Api.RevitAPIUI" Version="$(RevitVersion).*"/>
        <PackageVersion Include="ClosedXML" Version="0.104.2"/>
        <PackageVersion Include="FluentIcons.Wpf" Version="1.1.302" />
        <PackageVersion Include="Ookii.Dialogs.Wpf" Version="5.0.1" />
        <PackageVersion Include="System.Net.Http" Version="4.3.4"/>
        <PackageVersion Include="gong-wpf-dragdrop" Version="3.2.0" />
    </ItemGroup>

    <ItemGroup>
        <GlobalPackageReference Include="Polyfill" Version="11.2.0"/>
        <GlobalPackageReference Include="JetBrains.Annotations.Sources" Version="2026.2.0"/>
    </ItemGroup>
</Project>